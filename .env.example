# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA"

# SUAP
SUAP_BASE_URL=https://suap.ifrn.edu.br
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=
SUAP_REDIRECT_URI=http://localhost:3000/api/auth/suap/callback

# JWT
APP_JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Mobile
MOBILE_REDIRECT_URL=pontos://auth

# Vercel
# No projeto, defina Root Directory como sistema-pontos-api.
# DATABASE_URL precisa ser a URL com pooler (Neon, Supabase ou PgBouncer) e SSL.
# Cadastre no SUAP o mesmo endereço de SUAP_REDIRECT_URI.
# O callback do SUAP é o endereço que o navegador abre. Com o painel na Vercel,
# use o domínio do frontend, porque ele encaminha /api para esta API.
# SUAP_REDIRECT_URI=https://SEU-FRONTEND.vercel.app/api/auth/suap/callback
# FRONTEND_URL=https://SEU-FRONTEND.vercel.app